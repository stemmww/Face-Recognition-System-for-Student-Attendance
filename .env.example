# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=attendance
# Use port 5433 for local dev if you have a local PostgreSQL on 5432
# Inside Docker, services communicate on 5432 directly
DATABASE_URL=postgresql+asyncpg://app:changeme_strong_password@db:5432/attendance

# JWT
JWT_SECRET_KEY=changeme_generate_a_random_64_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI Models
AI_MODEL_PATH=/models
RECOGNITION_THRESHOLD=0.4

# File Storage
UPLOAD_DIR=/uploads

# Admin seed
ADMIN_EMAIL=admin@attendance.edu
ADMIN_PASSWORD=admin123
