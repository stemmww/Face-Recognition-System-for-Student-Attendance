# =============================================================================
# Single source of truth for all environment variables.
# Copy this file to .env and fill in real values.
# Docker Compose reads .env; backend config.py auto-discovers it too.
# Do NOT create a separate backend/.env — it will cause config drift.
# =============================================================================

# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=attendance
DATABASE_URL=postgresql+asyncpg://app:changeme_strong_password@localhost:5433/attendance

# JWT
JWT_SECRET_KEY=changeme_generate_a_random_64_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI Models
AI_MODEL_PATH=./models
RECOGNITION_THRESHOLD=0.5
# Tuned via ROC on LFW (AUC=0.988, EER=2.1%) — τ=0.22 gives FAR ≤ 0.1%
SELF_RECOGNITION_THRESHOLD=0.22
# Majority-voting: how many frames out of 5 must agree to accept verification.
# Higher = stricter (better security, more retries); lower = more lenient.
VOTING_MIN_FRAMES=3

# Face quality gate — reject low-quality frames before they reach ArcFace.
# Hard thresholds reject the photo; soft thresholds emit a warning only.
# Defaults are tuned for a 720p webcam at ~50 cm distance; raise them if
# your enrollment environment is controlled (good lighting, fixed pose).
QUALITY_MIN_FACE_PX=80
QUALITY_SOFT_FACE_PX=120
QUALITY_MIN_SHARPNESS=30.0
QUALITY_SOFT_SHARPNESS=80.0
QUALITY_MIN_BRIGHTNESS=40.0
QUALITY_MAX_BRIGHTNESS=220.0
QUALITY_MIN_CONTRAST=20.0
QUALITY_MAX_YAW=0.35
QUALITY_SOFT_YAW=0.20
QUALITY_MAX_PITCH=0.40

# File Storage
UPLOAD_DIR=./uploads

# QR Attendance
QR_TOKEN_EXPIRE_SECONDS=45
GPS_RADIUS_METERS=200

# Admin seed
ADMIN_EMAIL=admin@attendance.edu
ADMIN_PASSWORD=admin123

# SMTP settings for password reset emails
# For Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:3000
